    "deleteDuplicates": false,
    "deleteOnlyGlobaltix": true,
    "dryRun": false,
    "batchDelayMs": 1500,
    "requestDelayMs": 300,
    "timeoutMs": 60000,
    "retryAttempts": 3,
    "retryDelayMs": 2000
  }
